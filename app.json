{
  "expo": {
    "name": "Graze",
    "slug": "graze",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "graze",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A0A",
    "ios": {
      "bundleIdentifier": "codes.alex.graze",
      "icon": "./assets/expo.icon",
      "supportsTablet": false,
      "appleTeamId": "32FQN938UA"
    },
    "android": {
      "package": "codes.alex.graze",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 1,
      "permissions": [
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_BASAL_METABOLIC_RATE",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.WRITE_WEIGHT",
        "android.permission.health.WRITE_NUTRITION"
      ]
    },
    "plugins": [
      "./plugins/without-push",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      [
        "@kingstinct/react-native-healthkit",
        {
          "background": false,
          "NSHealthShareUsageDescription": "Graze reads your active and resting energy and your weight to show what you burned.",
          "NSHealthUpdateUsageDescription": "Graze saves what you log and your weigh-ins to Apple Health."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "minSdkVersion": 26
          }
        }
      ],
      "./plugins/with-scene-lifecycle",
      [
        "expo-camera",
        {
          "cameraPermission": "Graze uses the camera to scan barcodes on food.",
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#0A0A0A"
        }
      ],
      "react-native-health-connect",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
